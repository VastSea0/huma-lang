{
  "name": "huma-lang",
  "displayName": "Hüma Language Support",
  "description": "Syntax highlighting and LSP support for Hüma programming language",
  "version": "0.1.0",
  "publisher": "huma-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:huma"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [{
      "id": "huma",
      "aliases": ["Hüma", "huma"],
      "extensions": [".hb"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "huma",
      "scopeName": "source.huma",
      "path": "./syntaxes/huma.tmLanguage.json"
    }],
    "configuration": {
      "title": "Hüma",
      "properties": {
        "huma.lsp.serverPath": {
          "type": "string",
          "default": "huma-lsp",
          "description": "Path to the huma-lsp server binary (default: huma-lsp from PATH)."
        }
      }
    }
  }
}
