sayılar = [10, 20, 30] olsun
sayılar[0]'ı yazdır
"Hüma"[1]'i yazdır
sözlük = {"ad": "Hüma"} olsun
sözlük["ad"]'ı yazdır
sözlük["yok"]'u yazdır
dene { sayılar[-1] olsun } yakala hata { hata'yı yazdır }
dene { sayılar[1.5] olsun } yakala hata { hata'yı yazdır }
dene { "ab"[2] olsun } yakala hata { hata'yı yazdır }
dene { 5[0] olsun } yakala hata { hata'yı yazdır }
sayılar[3]'ü yazdır
