i = 0 olsun
i < 5 olduğu sürece {
    i = i + 1 olsun
    dene {
        i = 2 ise { devam }
        i = 4 ise { kır }
        i'yi yazdır
    } yakala {
        "yakalanmamalı"'yı yazdır
    }
}
j = 1'den 3'e kadar {
    k = 1'den 3'e kadar {
        k = 2 ise { devam }
        k = 3 ise { kır }
        (j * 10 + k)'yı yazdır
    }
}
"döngü bitti"'yi yazdır
(1 / 0)'ı yazdır
