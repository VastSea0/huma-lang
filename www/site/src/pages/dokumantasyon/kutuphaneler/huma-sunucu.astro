const codeUsage = `# CLI İzin Bayrağı Zorunludur:
# huma run uygulama.hb --izin ağ-sunucu

"huma_sunucu"'yi yükle

// 8080 portunda sunucu başlat
sunucu = sunucu_başlat(8080) olsun
"HTTP Sunucu 8080 portunda aktif..."'yı yazdır

// İşlem sonunda kaynağı güvenle kapat
dahili_sunucu_kapat(sunucu) olsun`;
