      </tr>
      <tr>
        <td><code>varyans(liste)</code></td>
        <td><code>liste</code> (Sayı Dizisi)</td>
        <td>Sayı</td>
        <td>Popülasyon varyansını hesaplar.</td>
      </tr>
      <tr>
        <td><code>standart_sapma(liste)</code></td>
        <td><code>liste</code> (Sayı Dizisi)</td>
        <td>Sayı</td>
        <td>Karekök varyans üzerinden standart sapmayı hesaplar.</td>
