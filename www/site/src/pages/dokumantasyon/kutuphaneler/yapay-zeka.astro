    <thead>
      <tr>
        <th>Metot / Fonksiyon</th>
        <th>Parametreler</th>
        <th>Açıklama</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>sinir_agi()</code></td>
        <td>Hiçbiri</td>
        <td>Yeni bir sinir ağı nesnesi örneği oluşturur.</td>
      </tr>
      <tr>
        <td><code>model.ilklendir()</code></td>
        <td>Hiçbiri</td>
