  <table>
    <thead>
      <tr>
        <th>İş yükü</th>
        <th>Kapsam</th>
        <th style="text-align: right;">Beklenen Çıktı</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>branch_loop</code></td>
        <td>200.000 koşullu sayısal durum geçişi</td>
        <td style="text-align: right;"><code>99740874156250</code></td>
      </tr>
      <tr>
        <td><code>numeric_loop</code></td>
        <td>200.000 LCG ve modüler toplam adımı</td>
        <td style="text-align: right;"><code>429301206370208</code></td>
      </tr>
      <tr>
