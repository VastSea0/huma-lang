import DocLayout from '../../layouts/DocLayout.astro';

const codeFib = `fibonacci fonksiyon olsun n alsın {
    n <= 1 ise { n'i döndür }
    (fibonacci(n - 1) + fibonacci(n - 2))'yi döndür
}

i = 0'dan 9'a kadar {
    "fib(" + i + ") = " + fibonacci(i)'yi yazdır
}`;

const codeNlp = `"nlp_temel"'i yükle

metin = "Hüma programlama dili Türkçe dilbilgisini korur." olsun

// Metni token'lara ayırma
tokens = nlp_islemci.tokenize(metin) olsun
"Token'lar: "'ı yazdır
tokens'ı yazdır

// Kelime köklerini bulma
kökler = nlp_stemmer.stem_liste(tokens) olsun
"Kökler: "'ı yazdır
kökler'i yazdır

// POS (Kelime türü) etiketleme
pos_sonucu = nlp_analizci.pos_etiketle(tokens) olsun
"POS Etiketleri: "'ni yazdır
pos_sonucu'nu yazdır`;

const codeClassEx = `sayaç sınıf olsun {
    değer = 0 olsun

    artır fonksiyon olsun miktar alsın {
        kendisi.değer = kendisi.değer + miktar olsun
        kendisi.değer'i döndür
    }

    sıfırla fonksiyon olsun {
        kendisi.değer = 0 olsun
        kendisi.değer'i döndür
    }
}

s = sayaç() olsun
s.artır(5)'i yazdır
s.artır(10)'u yazdır
s.sıfırla()'yı yazdır`;

const codeTryCatchEx = `dene {
    x = 10 / 0 olsun
    x'i yazdır
} yakala hata {
    "İşlem sırasında hata oluştu: " + hata'yı yazdır
}

"Program güvenle devam ediyor..."'yu yazdır`;
---

