<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <h3 class="footer-title">Hüma <span class="serif-italic">Programlama Dili</span></h3>
      <p class="footer-desc">Türkçe dilbilgisini koruyan genel amaçlı modern programlama dili zemini.</p>
      <div class="creator-note">
        <span>Tasarım & Geliştirme:</span>
        <a href="https://egehankahraman.vercel.app" target="_blank" rel="noopener noreferrer" class="creator-link">Egehan Kahraman</a>
      </div>
      <p class="license">MIT Lisansı — Açık Kaynak Topluluk Projesi</p>
    </div>

    <div class="footer-nav">
      <div class="nav-column">
        <span class="column-title">Dökümantasyon</span>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dokumantasyon/kurulum/`}>Kurulum & Başlarken</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dokumantasyon/sozdizimi/`}>Temel Sözdizimi</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dokumantasyon/dil-tanimi/`}>Dil Tanımı</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dokumantasyon/dil-grameri/`}>Kanonik EBNF</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dokumantasyon/kutuphaneler/`}>Kütüphaneler</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dokumantasyon/ornekler/`}>Örnek Programlar</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dokumantasyon/changelog/`}>Değişim Günlüğü</a>
      </div>

      <div class="nav-column">
        <span class="column-title">Mimari & Spesifikasyon</span>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dokumantasyon/bytecode-bicimi/`}>Bytecode Biçimi</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dokumantasyon/hmi/`}>HMI v1 Spesifikasyonu</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dokumantasyon/paket-guvenligi/`}>Paket Güvenliği</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dokumantasyon/muhendislik-anayasasi/`}>Mühendislik Anayasası</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/dokumantasyon/durum-ve-yol-haritasi/`}>Durum & Yol Haritası</a>
        <a href="https://github.com/vastsea0/huma-lang" target="_blank" rel="noopener noreferrer">GitHub Deposu ↗</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-color);
    padding: 4rem 1.5rem 3rem;
    margin-top: 5rem;
  }

  .footer-container {
    max-width: 1140px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 3rem;
  }

  .footer-brand {
    max-width: 380px;
  }

  .footer-title {
    font-size: 1.5rem;
    margin: 0 0 0.75rem 0;
  }

  .footer-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .creator-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .creator-link {
    color: var(--accent-color);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .creator-link:hover {
    color: var(--accent-hover);
  }

  .license {
    font-size: 0.8rem;
    color: var(--text-muted);
    opacity: 0.8;
  }

  .footer-nav {
    display: flex;
    gap: 4rem;
  }

  .nav-column {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .column-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-heading);
    margin-bottom: 0.5rem;
  }

  .nav-column a {
    color: var(--text-muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-column a:hover {
    color: var(--accent-color);
  }

  @media (max-width: 768px) {
    .footer {
      padding: 3rem 1rem 2rem;
      margin-top: 3rem;
    }

    .footer-container {
      flex-direction: column;
      gap: 2rem;
    }

    .footer-nav {
      flex-direction: column;
      gap: 1.5rem;
    }
  }
</style>
