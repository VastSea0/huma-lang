---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeTab?: string;
}

const { 
  title, 
  description = 'Hüma, Türkçe dilbilgisini koruyan genel amaçlı modern bir programlama dili zemini.',
  activeTab = ''
} = Astro.props;
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Hüma Programlama Dili</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Hüma Programlama Dili`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <Header activeTab={activeTab} />
    <main class="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .main-content {
    flex: 1;
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
</style>
